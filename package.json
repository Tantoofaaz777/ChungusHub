{
  "name": "chungushub",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "bun": ">=1.4.4"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#shared/*": "./shared/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.server.json && tsc -p src/service-worker/tsconfig.json",
    "test": "bun test",
    "server": "bun server/index.ts",
    "server:dev": "bun --watch server/index.ts",
    "start": "vite build && bun server/index.ts",
    "setup:tunnel": "bun scripts/setup-tunnel.ts",
    "package": "bun scripts/package.ts",
    "icons": "bun scripts/icons.ts"
  },
  "dependencies": {
    "dompurify": "^3.2.0",
    "gpt-tokenizer": "^3.4.0",
    "marked": "^15.0.0",
    "svelte-dnd-action": "^0.9.69",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.1.0",
    "@types/dompurify": "^3.0.5",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  }
}
